@using HandmadeMarketplace.Domain
@using System.Security.Claims
@model IReadOnlyList<Message>
@{ ViewData["Title"] = "پیام‌ها"; var userId = User.FindFirstValue(ClaimTypes.NameIdentifier); var threads = Model.GroupBy(x => new { x.ListingId, Other = x.SenderId == userId ? x.RecipientId : x.SenderId }); }
<h1 class="h3 mb-4">گفتگوهای من</h1>@if (Model.Count == 0) { <div class="empty-state">برای شروع گفتگو، در صفحه محصول «گفتگو با سازنده» را بزن.</div> }
@foreach (var thread in threads) { var last = thread.First(); <a class="panel d-block mb-3" asp-action="Thread" asp-route-id="@thread.Key.ListingId" asp-route-other="@thread.Key.Other"><h2 class="h6">@last.Listing.Title</h2><p class="text-muted mb-1">@(last.Body.Length > 100 ? last.Body[..100] + "…" : last.Body)</p><small>@last.SentAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small></a> }
