@model LoginInput
@inject HandmadeMarketplace.Infrastructure.SmsOptions Sms
@{ ViewData["Title"] = "ورود با ایمیل"; }
<section class="panel access-card" dir="rtl">
    <a class="access-brand" asp-controller="Home" asp-action="Index">خودم‌ساز</a>
    <h1>ورود با ایمیل و رمز عبور</h1>
    <form asp-action="Login" asp-route-returnUrl="@Context.Request.Query["returnUrl"]" method="post" data-access-form>
        <div asp-validation-summary="All" role="alert"></div>
        <label asp-for="Email" class="form-label">ایمیل</label>
        <input asp-for="Email" class="form-control" dir="ltr" autocomplete="email" required />
        <label asp-for="Password" class="form-label">رمز عبور</label>
        <input asp-for="Password" class="form-control" dir="ltr" autocomplete="current-password" required />
        <button class="btn btn-primary w-100 access-action" type="submit" data-busy="در حال ورود…">ورود</button>
    </form>
    @if (Sms.Enabled)
    {
        <a class="access-link" asp-controller="Access" asp-action="Start" asp-route-returnUrl="@Context.Request.Query["returnUrl"]">ورود یا عضویت با موبایل</a>
        <a class="access-link" asp-controller="MobileAccount" asp-action="Start" asp-route-purpose="RecoverPassword">بازیابی رمز عبور با موبایل</a>
    }
    <a class="access-link" asp-action="Register">ثبت‌نام با ایمیل</a>
</section>
<script src="~/js/access.js" asp-append-version="true" defer></script>
