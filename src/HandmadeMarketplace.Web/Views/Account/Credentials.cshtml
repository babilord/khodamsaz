@{ ViewData["Title"] = "اطلاعات ورود"; }
<section class="panel access-card">
    <h1>اطلاعات ورود</h1>
    <div asp-validation-summary="All" role="alert"></div>
    <form asp-action="SaveEmail" method="post">
        <label for="credentials-email" class="form-label">ایمیل</label>
        <input id="credentials-email" name="email" value="@ViewData["Email"]" type="email" autocomplete="email"
               maxlength="256" dir="ltr" class="form-control" required />
        @if (ViewData["HasPassword"] is true)
        {
            <label for="email-current-password" class="form-label">رمز عبور فعلی</label>
            <input id="email-current-password" name="currentPassword" type="password" autocomplete="current-password"
                   dir="ltr" class="form-control" required />
        }
        <button class="btn btn-primary w-100 access-action" type="submit">ذخیره ایمیل</button>
    </form>
    <form asp-action="SavePassword" method="post">
        @if (ViewData["HasPassword"] is true)
        {
            <label for="password-current-password" class="form-label">رمز عبور فعلی</label>
            <input id="password-current-password" name="currentPassword" type="password" autocomplete="current-password"
                   dir="ltr" class="form-control" required />
        }
        <label for="credentials-password" class="form-label">رمز عبور جدید</label>
        <input id="credentials-password" name="password" type="password" autocomplete="new-password"
               maxlength="128" dir="ltr" class="form-control" required />
        <label for="credentials-confirmation" class="form-label">تکرار رمز عبور جدید</label>
        <input id="credentials-confirmation" name="confirmation" type="password" autocomplete="new-password"
               maxlength="128" dir="ltr" class="form-control" required />
        <button class="btn btn-primary w-100 access-action" type="submit">ذخیره رمز عبور</button>
    </form>
    <a class="access-link" asp-action="Profile">بازگشت به پروفایل</a>
</section>
