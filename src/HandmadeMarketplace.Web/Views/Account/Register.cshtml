@model RegisterInput
@{ ViewData["Title"] = "عضویت"; }
<div class="panel auth-panel"><h1 class="h3">به جمع خلاق‌ها بپیوند</h1><form method="post"><div asp-validation-summary="All"></div><label asp-for="Name" class="form-label">نام نمایشی</label><input asp-for="Name" class="form-control mb-3" autocomplete="name" /><label asp-for="City" class="form-label">شهر</label><input asp-for="City" class="form-control mb-3" /><label asp-for="Email" class="form-label">ایمیل</label><input asp-for="Email" class="form-control mb-3" dir="ltr" autocomplete="email" /><label asp-for="Password" class="form-label">رمز عبور</label><input asp-for="Password" class="form-control" dir="ltr" autocomplete="new-password" /><p class="small text-muted mt-2">حداقل ۸ نویسه، شامل حرف بزرگ و کوچک انگلیسی، عدد و نشانه.</p><button class="btn btn-primary w-100">ساخت حساب</button></form><a class="d-block mt-3" asp-action="Login">قبلاً عضو شده‌ام</a></div>
