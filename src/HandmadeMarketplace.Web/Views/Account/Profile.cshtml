@model ProfileInput
@{ ViewData["Title"] = "پروفایل من"; }
<div class="panel auth-panel"><h1 class="h3">پروفایل من</h1><form method="post"><div asp-validation-summary="All"></div><label asp-for="Name" class="form-label">نام نمایشی</label><input asp-for="Name" class="form-control mb-3" /><label asp-for="City" class="form-label">شهر</label><input asp-for="City" class="form-control mb-3" /><label asp-for="Bio" class="form-label">درباره کار و هنر شما</label><textarea asp-for="Bio" rows="5" class="form-control mb-3"></textarea><button class="btn btn-primary">ذخیره تغییرات</button></form></div>
@inject HandmadeMarketplace.Infrastructure.SmsOptions Sms
@if (Sms.Enabled && !User.IsInRole("Admin"))
{
    <div class="auth-panel"><a asp-controller="MobileAccount" asp-action="Start" asp-route-purpose="VerifyPhone">تأیید شماره موبایل</a></div>
}

@inject Microsoft.AspNetCore.Identity.UserManager<HandmadeMarketplace.Infrastructure.AppUser> AccountUsers
@{
    var account = await AccountUsers.GetUserAsync(User);
}
@if (account is { PhoneNumberConfirmed: true, VerifiedMobile: not null }
    && (await AccountUsers.GetRolesAsync(account)).Count == 0
    && !await AccountUsers.GetTwoFactorEnabledAsync(account))
{
    <div class="auth-panel"><a asp-action="Credentials">مدیریت ایمیل و رمز عبور</a></div>
}
