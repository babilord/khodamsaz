@using HandmadeMarketplace.Domain
@model IReadOnlyList<Listing>
@{ ViewData["Title"] = "مدیریت بازار"; }
<h1 class="h3">مدیریت بازار</h1><p class="text-muted">بررسی ۲۰۰ آگهی اخیر؛ آگهی‌های در انتظار بررسی در ابتدا قرار دارند.</p><div class="row g-3 mb-4"><div class="col-sm-4 panel">در انتظار بررسی: @Model.Count(x => x.Status == ListingStatus.Pending)</div><div class="col-sm-4 panel">منتشرشده: @Model.Count(x => x.Status == ListingStatus.Approved)</div><div class="col-sm-4 panel">ردشده: @Model.Count(x => x.Status == ListingStatus.Rejected)</div></div>
@foreach (var item in Model) { <div class="panel mb-3 d-flex flex-wrap gap-3 justify-content-between"><div><a asp-controller="Listings" asp-action="Details" asp-route-id="@item.Id" class="fw-bold">@item.Title</a><p class="mb-0">@item.City · @(item.Price == 0 ? "توافقی" : PersianPrice.Format(item.Price) + " تومان") · <span class="status">@UiText.Status(item.Status)</span></p></div><div class="d-flex gap-2 align-items-center"><form asp-action="Moderate" method="post"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="approve" value="true" /><button class="btn btn-primary">تأیید و انتشار</button></form><form asp-action="Moderate" method="post"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="approve" value="false" /><button class="btn btn-outline-danger">رد / حذف از نمایش</button></form></div></div> }
