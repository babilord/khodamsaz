@using HandmadeMarketplace.Domain
@model IReadOnlyList<Listing>
@{ ViewData["Title"] = "آگهی‌های من"; }
<div class="d-flex justify-content-between mb-4"><h1 class="h3">آگهی‌های من</h1><a class="btn btn-primary" asp-action="Edit">ثبت آگهی تازه</a></div>
@if (Model.Count == 0) { <div class="empty-state">اولین ساخته‌ات را معرفی کن.</div> }
@foreach (var item in Model) { <div class="panel mb-3 d-flex flex-wrap justify-content-between gap-3"><div><a asp-action="Details" asp-route-id="@item.Id" class="fw-bold">@item.Title</a><p class="mb-0 text-muted">@(item.Price == 0 ? "توافقی" : PersianPrice.Format(item.Price) + " تومان") · <span class="status">@UiText.Status(item.Status)</span></p></div><div class="d-flex flex-wrap gap-2 align-items-center"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a><form asp-action="Sold" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-outline-secondary">فروخته شد</button></form><form asp-action="Delete" method="post" onsubmit="return confirm('آگهی و گفتگوهای مرتبط حذف شوند؟')"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-outline-danger">حذف</button></form></div></div> }
