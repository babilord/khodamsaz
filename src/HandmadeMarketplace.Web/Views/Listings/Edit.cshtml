@using HandmadeMarketplace.Application
@using HandmadeMarketplace.Domain
@model ListingInput
@{ ViewData["Title"] = Model.Id == 0 ? "ثبت آگهی" : "ویرایش آگهی"; var categories = (IReadOnlyList<Category>)ViewBag.Categories; var images = ViewBag.Images as List<ListingImage> ?? new(); }
<div class="panel mx-auto" style="max-width:800px"><h1 class="h3">@ViewData["Title"]</h1><p class="text-muted">چیزی را معرفی کن که خودت ساخته‌ای. آگهی پس از بررسی منتشر می‌شود.</p><form method="post" enctype="multipart/form-data"><div asp-validation-summary="All" role="alert"></div><input asp-for="Id" type="hidden" /><label asp-for="Title" class="form-label">عنوان ساخته</label><input asp-for="Title" class="form-control mb-3" /><label asp-for="Description" class="form-label">داستان و مشخصات محصول</label><textarea asp-for="Description" rows="6" class="form-control mb-3"></textarea><div class="row"><div class="col-md-6"><label asp-for="CategoryId" class="form-label">دسته‌بندی</label><select asp-for="CategoryId" class="form-select mb-3"><option value="">انتخاب کنید</option>@foreach (var c in categories) { <option value="@c.Id">@(c.ParentId.HasValue ? "— " : "")@c.Name</option> }</select></div><div class="col-md-6"><label asp-for="City" class="form-label">شهر</label><input asp-for="City" class="form-control mb-3" /></div></div><label asp-for="Price" class="form-label">قیمت به تومان (صفر: توافقی)</label><input asp-for="Price" value="@PersianPrice.Format(Model.Price)" type="text" inputmode="numeric" data-price="true" class="form-control mb-3" /><label for="images" class="form-label">تصاویر محصول</label><input id="images" name="images" type="file" multiple accept="image/jpeg,image/png" class="form-control mb-2" /><p class="small text-muted">حداکثر ۶ تصویر JPEG یا PNG، هرکدام تا ۵ مگابایت.</p><div class="d-flex flex-wrap gap-3 mb-3">@foreach (var image in images) { <label><img class="thumb d-block" src="@image.Path" alt="تصویر آگهی" /><input type="checkbox" name="removeImages" value="@image.Id" /> حذف تصویر</label> }</div><button class="btn btn-primary">ذخیره و ارسال برای بررسی</button><a class="btn btn-link" asp-action="Mine">انصراف</a></form></div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/listing-validation.js" asp-append-version="true"></script>
}